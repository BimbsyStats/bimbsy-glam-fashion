<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="Bimbsy Glam Fashion — ready-to-wear fashion, fascinators, accessories and handmade details in Lagos, Nigeria.">
<link rel="icon" type="image/png" href="data:image/png;base64,"><title>Bimbsy Glam Fashion | Wear Your Confidence</title>
<style>
:root{--wine:#6d1837;--dark:#3d1024;--rose:#f7e8ed;--cream:#fffaf6;--gold:#c79a55;--ink:#292329;--muted:#746a70;--shadow:0 18px 45px rgba(61,16,36,.12);--radius:22px}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:"Segoe UI",Arial,sans-serif;color:var(--ink);background:var(--cream);line-height:1.6}a{color:inherit;text-decoration:none}button,input,textarea,select{font:inherit}
.announcement{text-align:center;background:var(--dark);color:#fff;padding:9px 16px;font-size:.83rem;letter-spacing:.04em}
header{position:sticky;top:0;z-index:20;background:rgba(255,250,246,.96);backdrop-filter:blur(12px);border-bottom:1px solid #ead9df}
.nav{max-width:1180px;margin:auto;padding:15px 22px;display:flex;align-items:center;justify-content:space-between;gap:18px}
.brand{display:flex;align-items:center;gap:11px}.brand-logo{width:118px;height:68px;object-fit:contain;flex-shrink:0;background:#fff;border-radius:8px}.brand-mark{display:none}
.brand-name{color:var(--dark);font-family:Georgia,serif;font-size:1.1rem;font-weight:700;line-height:1.15}.brand-tag{color:var(--muted);font-size:.68rem;letter-spacing:.15em;text-transform:uppercase;margin-top:4px}
.nav-links{display:flex;align-items:center;gap:25px;font-size:.92rem}.nav-links a:hover{color:var(--wine)}.menu-toggle{display:none;border:0;background:transparent;color:var(--wine);font-size:1.7rem;cursor:pointer}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:12px 20px;border:1px solid var(--wine);border-radius:999px;background:var(--wine);color:white;cursor:pointer;font-weight:650;transition:transform .2s,background .2s}.btn:hover{background:var(--dark);transform:translateY(-2px)}.btn-outline{background:transparent;color:var(--wine)}.btn-outline:hover{color:white}
.hero{overflow:hidden;background:radial-gradient(circle at 83% 20%,#f0d1dc 0,transparent 30%),linear-gradient(120deg,#fffaf6,#f8e9ee 58%,#efd4dd)}
.hero-inner{max-width:1180px;min-height:570px;margin:auto;padding:72px 22px;display:grid;grid-template-columns:1.08fr .92fr;align-items:center;gap:55px}
.eyebrow{color:var(--wine);text-transform:uppercase;letter-spacing:.2em;font-size:.76rem;font-weight:750}h1,h2,h3{font-family:Georgia,"Times New Roman",serif;line-height:1.12}
h1{font-size:clamp(2.8rem,6vw,5.2rem);color:var(--dark);margin:16px 0 20px;letter-spacing:-.045em}h1 em{color:var(--wine);font-weight:500}.hero p{max-width:530px;color:#65545d;font-size:1.08rem}.hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}.hero-note{display:flex;align-items:center;gap:10px;margin-top:30px;color:var(--muted);font-size:.9rem}.hero-note span{color:var(--gold);font-size:1.25rem}
.hero-art{min-height:410px;position:relative;display:grid;place-items:center}.art-frame{width:min(100%,390px);height:440px;position:relative;overflow:hidden;border-radius:48% 48% 20px 20px;border:8px solid rgba(255,255,255,.7);box-shadow:var(--shadow);background:linear-gradient(150deg,#8e3b5c,#d7a3b5 52%,#f2d9df)}.art-frame:before{content:"";position:absolute;inset:22px;border:1px solid rgba(255,255,255,.55);border-radius:48% 48% 12px 12px}.fashion-illustration{position:absolute;inset:0;display:grid;place-items:center}.fashion-illustration svg{width:94%;height:95%}
.floating-label{position:absolute;right:-5px;bottom:30px;max-width:190px;background:white;padding:15px 18px;border-radius:16px;box-shadow:var(--shadow);font-family:Georgia,serif;color:var(--dark)}.floating-label small{display:block;color:var(--muted);font-family:"Segoe UI",Arial,sans-serif;font-size:.75rem}
section{padding:82px 22px}.container{max-width:1120px;margin:auto}.section-heading{max-width:650px;margin:0 auto 42px;text-align:center}.section-heading h2{color:var(--dark);font-size:clamp(2.1rem,4vw,3.2rem);margin:12px 0}.section-heading p{color:var(--muted);margin:0}
.categories{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.category-card{min-height:275px;padding:27px;border-radius:var(--radius);position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:flex-end;background:linear-gradient(145deg,#f5dfe6,#e7b9c9)}.category-card:nth-child(2){background:linear-gradient(145deg,#f5ead7,#d7b982)}.category-card:nth-child(3){background:linear-gradient(145deg,#eadfe9,#bd9db9)}.category-icon{position:absolute;right:20px;top:8px;font-size:5.5rem;opacity:.5}.category-card h3{font-size:1.7rem;margin:0 0 7px;color:var(--dark)}.category-card p{margin:0 0 16px;color:#5f4b55;max-width:280px}.text-link{color:var(--wine);font-weight:750}
.about{background:#f6e9ed}.about-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:55px;align-items:center}.about-panel{min-height:360px;border-radius:48% 48% 22px 22px;background:var(--wine);display:grid;place-items:center;text-align:center;padding:35px;color:white;box-shadow:var(--shadow)}.monogram{font-family:Georgia,serif;font-size:5rem;line-height:1;color:#f0d5b0}.about-panel p{max-width:240px;margin:18px auto 0}.about-copy h2{font-size:clamp(2.1rem,4vw,3.2rem);color:var(--dark);margin:12px 0 18px}.about-copy p{color:#65545d}.values{display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-top:24px}.value{display:flex;gap:10px;align-items:flex-start}.value b{display:block;color:var(--dark)}.value span{color:var(--gold);font-size:1.2rem}
.process-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.process{border:1px solid #ead9df;border-radius:18px;padding:25px;background:white}.number{color:var(--gold);font-family:Georgia,serif;font-size:2.4rem}.process h3{margin:8px 0;color:var(--dark);font-size:1.35rem}.process p{color:var(--muted);margin:0}
.contact{background:var(--dark);color:white}.contact .section-heading h2{color:white}.contact .section-heading p{color:#e3cbd4}.contact-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:35px;align-items:start}.contact-details{display:grid;gap:17px}.contact-item{padding:18px;border:1px solid rgba(255,255,255,.18);border-radius:16px}.contact-item .label{color:#e4c5d1;font-size:.78rem;text-transform:uppercase;letter-spacing:.12em}.contact-item p{margin:5px 0 0;overflow-wrap:anywhere}.contact-item a:hover{text-decoration:underline}
.contact-form{padding:26px;border-radius:22px;background:white;color:var(--ink)}.contact-form h3{margin:0 0 18px;color:var(--dark);font-size:1.6rem}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:13px}label{display:block;font-size:.85rem;font-weight:650;margin-bottom:6px;color:#4d3e45}input,textarea,select{width:100%;border:1px solid #dfcfd5;border-radius:10px;padding:12px 13px;background:#fffdfc;color:var(--ink);outline:none;margin-bottom:14px}input:focus,textarea:focus,select:focus{border-color:var(--wine);box-shadow:0 0 0 3px rgba(109,24,55,.1)}textarea{resize:vertical;min-height:100px}.contact-form .btn{width:100%}.form-help{color:var(--muted);font-size:.78rem;margin:12px 0 0}
footer{background:#290a18;color:#e8d5dc;padding:27px 22px}.footer-inner{max-width:1120px;margin:auto;display:flex;justify-content:space-between;align-items:center;gap:18px;flex-wrap:wrap;font-size:.85rem}.footer-inner strong{color:white;font-family:Georgia,serif}.socials{display:flex;gap:17px}.socials a:hover{color:white}
.whatsapp-float{position:fixed;z-index:30;right:20px;bottom:20px;width:58px;height:58px;display:grid;place-items:center;border-radius:50%;background:#20b968;color:white;box-shadow:0 8px 25px rgba(0,0,0,.22);font-size:1.7rem}.whatsapp-float:hover{transform:translateY(-3px)}
@media(max-width:800px){.nav-links{display:none;position:absolute;left:0;right:0;top:100%;padding:18px 22px 24px;background:var(--cream);border-bottom:1px solid #ead9df;flex-direction:column;align-items:stretch;gap:15px}.nav-links.open{display:flex}.nav-links .btn{text-align:center}.menu-toggle{display:block}.hero-inner{grid-template-columns:1fr;padding-top:55px;gap:28px}.hero-art{min-height:350px}.art-frame{height:365px;width:min(85%,330px)}.floating-label{right:2%;bottom:15px}.categories,.process-grid{grid-template-columns:1fr}.category-card{min-height:230px}.about-grid,.contact-grid{grid-template-columns:1fr;gap:30px}.about-panel{min-height:290px}section{padding:62px 20px}}
@media(max-width:480px){.brand-logo{width:88px;height:56px}.brand-name{font-size:.95rem}.brand-tag{font-size:.58rem}.brand-mark{width:39px;height:39px}h1{font-size:2.75rem}.form-row,.values{grid-template-columns:1fr}.contact-form{padding:20px}.hero-actions .btn{width:100%}}
</style>
</head>
<body>
<div class="announcement">A little glamour, made with care · Lagos, Nigeria</div>
<header><nav class="nav" aria-label="Main navigation">
<a class="brand" href="#home" aria-label="Bimbsy Glam Fashion home"><img class="brand-logo" src="data:image/png;base64," alt="Bimbsy Glam Fashion logo"><div><div class="brand-name">Bimbsy Glam Fashion</div><div class="brand-tag">Wear your confidence</div></div></a>
<button class="menu-toggle" id="menuToggle" aria-label="Open navigation" aria-expanded="false">☰</button>
<div class="nav-links" id="navLinks"><a href="#collections">Collections</a><a href="#about">Our Story</a><a href="#process">How to Order</a><a href="#contact">Contact</a><a class="btn" href="#contact">Enquire Now</a></div>
</nav></header>
<main>
<section class="hero" id="home"><div class="hero-inner"><div>
<div class="eyebrow">Style that feels like you</div><h1>Find your fit.<br><em>Own your glow.</em></h1>
<p>Thoughtfully made fashion for women who love to feel polished, confident and beautifully themselves. Explore ready-to-wear looks, statement accessories and handmade details from Bimbsy Glam Fashion.</p>
<div class="hero-actions"><a class="btn" href="#collections">Explore Our Style ↗</a><a class="btn btn-outline" href="#contact">Talk to Us</a></div>
<div class="hero-note"><span>✦</span> Designed with care in Lagos, Nigeria</div>
</div><div class="hero-art" aria-label="Decorative fashion illustration"><div class="art-frame"><div class="fashion-illustration">
<svg viewBox="0 0 400 460" role="img" aria-label="Abstract illustration of an elegant fashion outfit"><defs><linearGradient id="dress" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff4e8"/><stop offset=".55" stop-color="#ead1b5"/><stop offset="1" stop-color="#c69a68"/></linearGradient></defs>
<circle cx="205" cy="84" r="48" fill="#6c3a36"/><path d="M160 73 Q164 18 212 26 Q253 30 253 77 Q237 45 213 47 Q186 72 160 73" fill="#2f1723"/><path d="M179 121 L230 121 L244 158 L167 158 Z" fill="#b77f78"/><path d="M167 148 Q204 169 242 148 L275 213 L251 251 L271 405 L132 405 L154 251 L128 213 Z" fill="url(#dress)"/><path d="M167 149 L202 184 L242 148 L231 209 L204 229 L177 208 Z" fill="#fffaf3"/><path d="M166 151 L140 213 L167 240 L185 203 Z" fill="#f5e1d0"/><path d="M242 151 L270 213 L243 240 L225 203 Z" fill="#d9b58f"/><path d="M185 202 L224 202 L239 405 L169 405 Z" fill="#6d1837"/><path d="M169 405 L198 405 L196 448 L143 448 Z" fill="#3d1024"/><path d="M212 405 L239 405 L264 448 L210 448 Z" fill="#3d1024"/><path d="M176 228 Q204 244 232 228" fill="none" stroke="#c79a55" stroke-width="4"/><circle cx="178" cy="130" r="6" fill="#e8c989"/><circle cx="231" cy="130" r="6" fill="#e8c989"/><path d="M103 351 C71 298 88 224 113 187" fill="none" stroke="#fff4e8" stroke-width="2" opacity=".7"/><path d="M300 341 C326 281 310 225 288 192" fill="none" stroke="#fff4e8" stroke-width="2" opacity=".7"/><g fill="#f6e4cb" opacity=".8"><circle cx="88" cy="119" r="3"/><circle cx="300" cy="100" r="4"/><circle cx="315" cy="151" r="2"/><circle cx="91" cy="280" r="2"/><circle cx="302" cy="302" r="3"/></g></svg>
</div></div><div class="floating-label">Made for your moment<small>Fashion · Accessories · Details</small></div></div></div></section>
<section id="collections"><div class="container"><div class="section-heading"><div class="eyebrow">Explore the brand</div><h2>Pieces for your kind of glamour</h2><p>From everyday confidence to special-occasion finishing touches, discover what we make at Bimbsy Glam Fashion.</p></div>
<div class="categories"><article class="category-card"><div class="category-icon">✂</div><h3>Ready-to-Wear</h3><p>Easy-to-style pieces designed to bring polish and personality to your wardrobe.</p><a class="text-link order-link" data-product="Ready-to-wear clothing" href="#contact">Enquire about outfits ↗</a></article>
<article class="category-card"><div class="category-icon">✧</div><h3>Fascinators & Accessories</h3><p>Eye-catching finishing touches for celebrations, events and standout looks.</p><a class="text-link order-link" data-product="Fascinators and accessories" href="#contact">Ask about accessories ↗</a></article>
<article class="category-card"><div class="category-icon">♡</div><h3>Handmade Details</h3><p>Thoughtful handmade and beaded pieces made to add a personal touch.</p><a class="text-link order-link" data-product="Handmade and beaded items" href="#contact">Discuss a custom request ↗</a></article></div></div></section>
<section class="about" id="about"><div class="container about-grid"><div class="about-panel"><div><div class="monogram">BG</div><p><strong>Bimbsy Glam Fashion</strong><br>Wear your confidence.</p></div></div><div class="about-copy"><div class="eyebrow">Our story</div><h2>Fashion with personality, made with care.</h2><p>Bimbsy Glam Fashion is a Lagos-based fashion brand built around creativity, self-expression and the little details that make an outfit feel special.</p><p>We create ready-to-wear looks and accessories for customers who want style with a personal touch. Follow our journey as sketches become patterns, fabric becomes fashion, and ideas come to life.</p>
<div class="values"><div class="value"><span>✦</span><div><b>Creative design</b><small>Fresh ideas and thoughtful details.</small></div></div><div class="value"><span>♡</span><div><b>Personal touch</b><small>Friendly communication and care.</small></div></div><div class="value"><span>✂</span><div><b>Made with care</b><small>Attention to fit and finishing.</small></div></div><div class="value"><span>✧</span><div><b>Your style, your way</b><small>Ask about available sizes and custom requests.</small></div></div></div></div></div></section>
<section id="process"><div class="container"><div class="section-heading"><div class="eyebrow">Simple and personal</div><h2>How to order</h2><p>Have a look in mind? Send us a message and we'll help you with the next step.</p></div><div class="process-grid"><article class="process"><div class="number">01</div><h3>Choose your style</h3><p>Tell us which outfit, accessory or handmade item you're interested in.</p></article><article class="process"><div class="number">02</div><h3>Confirm the details</h3><p>We'll discuss availability, sizes, colours, pricing and delivery before you decide.</p></article><article class="process"><div class="number">03</div><h3>Place your order</h3><p>Confirm your order directly with us on WhatsApp or by email.</p></article></div></div></section>
<section class="contact" id="contact"><div class="container"><div class="section-heading"><div class="eyebrow" style="color:#e4c5d1">Let's connect</div><h2>Let's find your next favourite look.</h2><p>Questions, product enquiries or custom requests? We'd love to hear from you.</p></div>
<div class="contact-grid"><div class="contact-details"><div class="contact-item"><div class="label">Email</div><p><a href="mailto:bimbsyglamfashion@gmail.com">bimbsyglamfashion@gmail.com</a></p></div><div class="contact-item"><div class="label">Phone / WhatsApp</div><p><a href="tel:+2348163594103">0816 359 4103</a></p><p><a href="https://wa.me/2348163594103" target="_blank" rel="noopener">Chat with us on WhatsApp ↗</a></p></div><div class="contact-item"><div class="label">Location</div><p>Baba Isale Street, Lekki Garden Phase 2, Abraham Adesanya, Lagos, Nigeria</p></div><div class="contact-item"><div class="label">Business hours</div><p>Message us to confirm availability and response times.</p></div></div>
<form class="contact-form" id="enquiryForm"><h3>Send an enquiry</h3><div class="form-row"><div><label for="customerName">Your name</label><input id="customerName" name="customerName" autocomplete="name" required placeholder="Enter your name"></div><div><label for="customerPhone">Your phone (optional)</label><input id="customerPhone" name="customerPhone" autocomplete="tel" placeholder="Phone number"></div></div>
<label for="interest">What are you interested in?</label><select id="interest" name="interest"><option>Ready-to-wear clothing</option><option>Fascinators and accessories</option><option>Handmade and beaded items</option><option>Custom request</option><option>General enquiry</option></select><label for="message">Your message</label><textarea id="message" name="message" required placeholder="Tell us the style, size, colour or item you're interested in..."></textarea><button class="btn" type="submit">Send via WhatsApp ↗</button><p class="form-help">This form opens WhatsApp with your message prepared. It does not send anything until you press Send in WhatsApp.</p></form></div></div></section>
</main>
<footer><div class="footer-inner"><div><strong>Bimbsy Glam Fashion</strong><br><span>Wear your confidence.</span></div><div>© <span id="year"></span> Bimbsy Glam Fashion. All rights reserved.</div><div class="socials"><a href="mailto:bimbsyglamfashion@gmail.com">Email</a><a href="https://wa.me/2348163594103" target="_blank" rel="noopener">WhatsApp</a></div></div></footer>
<a class="whatsapp-float" href="https://wa.me/2348163594103?text=Hello%20Bimbsy%20Glam%20Fashion%2C%20I%27d%20like%20to%20make%20an%20enquiry." target="_blank" rel="noopener" aria-label="Chat with Bimbsy Glam Fashion on WhatsApp">☏</a>
<script>
const menuToggle=document.getElementById('menuToggle'),navLinks=document.getElementById('navLinks');
menuToggle.addEventListener('click',()=>{const open=navLinks.classList.toggle('open');menuToggle.setAttribute('aria-expanded',String(open));menuToggle.setAttribute('aria-label',open?'Close navigation':'Open navigation');menuToggle.textContent=open?'×':'☰';});
navLinks.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{navLinks.classList.remove('open');menuToggle.setAttribute('aria-expanded','false');menuToggle.setAttribute('aria-label','Open navigation');menuToggle.textContent='☰';}));
document.querySelectorAll('.order-link').forEach(a=>a.addEventListener('click',()=>{document.getElementById('interest').value=a.dataset.product;}));
document.getElementById('enquiryForm').addEventListener('submit',function(e){e.preventDefault();const name=document.getElementById('customerName').value.trim(),phone=document.getElementById('customerPhone').value.trim(),interest=document.getElementById('interest').value,message=document.getElementById('message').value.trim();if(!name||!message)return;const text=['Hello Bimbsy Glam Fashion!','','Name: '+name,phone?'Phone: '+phone:'','Enquiry: '+interest,'Message: '+message].filter(Boolean).join('\n');window.open('https://wa.me/2348163594103?text='+encodeURIComponent(text),'_blank','noopener,noreferrer');});
document.getElementById('year').textContent=new Date().getFullYear();
</script>
</body>
</html>